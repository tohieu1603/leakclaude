# ── Required: LLM provider ──────────────────────────────────────────────────
AI_API_KEY=your-provider-api-key
AI_API_URL=https://ark.ap-southeast.bytepluses.com/api/coding/v3
AI_MODEL=kimi-k2.5

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
WORKSPACE_ROOT=/absolute/path/to/your/workspace

# Where persisted JSONL sessions live (default: ~/.agentmini-nest/sessions)
# SESSIONS_DIR=

# ── Auth (opt-in) ───────────────────────────────────────────────────────────
# Comma-separated allowlist of API keys. When empty, auth is OFF (dev mode).
# Clients send either:  Authorization: Bearer <key>  OR  X-API-Key: <key>
# API_KEYS=changeme-1,changeme-2

# ── Rate limit ──────────────────────────────────────────────────────────────
# Window in ms (default 60000 = 1 minute) and max requests per window per IP
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=30
# Set to 1 to disable entirely (e.g. when running behind another rate limiter)
RATE_LIMIT_DISABLED=0

# ── Optional integrations ───────────────────────────────────────────────────
# BRAVE_SEARCH_API_KEY=          # if unset, WebSearch falls back to DuckDuckGo
