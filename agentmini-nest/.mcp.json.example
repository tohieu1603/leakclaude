{
  "$comment": "Copy to .mcp.json to enable MCP servers. Each entry spawns a child process at startup.",
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/Users/admin/for-learn-claude-cli/agentmini-nest"]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "disabled": true
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_replace_me"
      },
      "disabled": true
    }
  }
}
